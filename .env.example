# Google AI Studio API Key (for Gemini)
GOOGLE_API_KEY=your_google_api_key

# Instagram Username (used to identify "self" messages in imported data)
INSTAGRAM_USERNAME=your_username

# Master Privacy & Local LLM Controls
ENABLE_CLOUD_AI=true
APP_PASSWORD=your_bcrypt_hash_here # MUST be bcrypt. Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
SECRET_KEY=your_secret_key_here # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Local LLM Configuration
LLM_PROVIDER=gemini
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434

# Data Config
DATA_DIR=
USE_GPU=false

# Ollama request timeouts (seconds)
# OLLAMA_LIST_TIMEOUT controls the /api/tags endpoint (model listing on startup)
# OLLAMA_GENERATE_TIMEOUT controls the /api/generate endpoint (LLM inference)
OLLAMA_LIST_TIMEOUT=10
OLLAMA_GENERATE_TIMEOUT=120
